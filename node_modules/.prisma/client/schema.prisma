generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Satellite {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  // keep this optional; or remove it entirely if you don't use it
  model         String?     @default("custom")
  uploadedModel Json?
  baseModel     Json?
  components    Component[]
  createdAt     DateTime    @default(now())
}

model Component {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  satelliteId String    @db.ObjectId
  satellite   Satellite @relation(fields: [satelliteId], references: [id], onDelete: Cascade)

  componentId String
  name        String
  category    String
  icon        String
  mass        Float
  power       Int
  color       Int
  instanceId  String
  position    Json
  rotation    Json
  scale       Float

  // scope instanceId uniqueness to the parent satellite
  @@unique([satelliteId, instanceId])
}
